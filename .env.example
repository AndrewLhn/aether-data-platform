# Aether local-development configuration
# Copy to .env for a future Docker-based local environment. Do not commit .env.

# Images and ports (non-production defaults)
COMPOSE_PROJECT_NAME=aether
POSTGRES_PORT=5432
KAFKA_PORT=9092
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
TRINO_PORT=8080

# Development-only values. Never reuse them outside the local stack.
POSTGRES_DB=aether
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether-local-postgres
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=aether-local-debezium
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=aether-local-minio

# Object storage namespace
S3_ENDPOINT=http://minio:9000
S3_BUCKET=aether-lakehouse
S3_REGION=us-east-1

# Observability and behavior defaults
LOG_LEVEL=INFO
CHECKPOINT_INTERVAL_SECONDS=60
RECONCILIATION_WINDOW_MINUTES=15
KAFKA_CONNECT_PORT=8083
