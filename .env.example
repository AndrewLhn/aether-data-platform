# Aether local-development configuration.
# Copy to .env (`make env` does this for you). Never commit .env.

# ---------------------------------------------------------------------------
# Project and host ports
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=aether
POSTGRES_PORT=5432
KAFKA_PORT=9092
KAFKA_CONNECT_PORT=8083
FLINK_UI_PORT=8081
S3_PORT=8333

# ---------------------------------------------------------------------------
# Development-only credentials. Never reuse them outside the local stack.
# ---------------------------------------------------------------------------
POSTGRES_DB=aether
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether-local-postgres
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=aether-local-debezium

# JDBC URL for the Iceberg catalog, which stores its table metadata in
# PostgreSQL. Must point at the same database and credentials as above; the
# in-network host is the compose service name.
POSTGRES_JDBC_URL=jdbc:postgresql://postgres:5432/aether

# Object storage (SeaweedFS, S3-compatible). MinIO Community Edition was
# archived upstream on 2026-02-13, so the local stack no longer uses it.
S3_ACCESS_KEY_ID=aether-local-s3
S3_SECRET_ACCESS_KEY=aether-local-s3-secret
S3_REGION=us-east-1
S3_WAREHOUSE_BUCKET=aether-lakehouse
S3_CHECKPOINT_BUCKET=aether-flink

# Endpoint used by services inside the compose network. Flink and Iceberg only
# ever see this value, which keeps the object store swappable.
S3_ENDPOINT_INTERNAL=http://seaweedfs:8333
# Endpoint for tools running on the host (aws cli, scripts, Trino later).
S3_ENDPOINT_HOST=http://localhost:8333

# In-network Kafka bootstrap for containers. The host-facing listener is
# localhost:${KAFKA_PORT}.
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:19092

# ---------------------------------------------------------------------------
# Streaming behaviour
# ---------------------------------------------------------------------------
FLINK_TASK_SLOTS=2
CHECKPOINT_INTERVAL_SECONDS=30
